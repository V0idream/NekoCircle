# JWT 签名密钥（生产环境请替换为随机长字符串）
JWT_SECRET=your-secret-key-change-in-production

# 可选独立管理员签名密钥；本地初始化脚本会自动生成。
# ADMIN_JWT_SECRET=another-random-secret-at-least-32-characters
# 生产环境禁止网页首次初始化；通过本机初始化脚本设置管理员。
ADMIN_SETUP_ENABLED=false

# Cloudflare 部署的管理员初始哈希和独立 pepper 只通过 Secrets 配置。
# ADMIN_PASSWORD_HASH 和 ADMIN_PASSWORD_PEPPER 不要填写在仓库文件中。
# 具体配置见 docs/cloudflare-deployment.md；公开生成和下载无需登录。

# 可选：自定义数据库路径（默认 ./data/circle.db）
# 部署到 Railway/Render 等平台时，指向持久化 Volume 的路径
# DB_PATH=/data/circle.db

# 可选：HTTP/SOCKS 代理（访问 Twitter 头像等外部资源时使用）
# HTTPS_PROXY=socks5h://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7890

# 可选：仅供 Yahoo 实时搜索使用的代理。
# http:// 地址按 forward proxy 使用；https:// 地址按兼容上游的中继服务根地址使用。
# YAHOO_PROXY=https://your-yahoo-relay.example.com/api/v1

# 可选：站点的对外地址（带协议，例如 https://circle.example.com）。
# 用于补全 metadata 里的相对路径——尤其是分享用的 og:image。
# 不配置时 Next 会把它解析成 http://localhost:3000/...，导致分享链接没有预览图。
# SITE_URL=https://circle.example.com

# 可选：网页底部的构建版本号。不设置时自动使用 Git 提交号，ZIP 部署使用 UTC 构建时间。
# 必须在 npm run build 前设置；仅重启服务不会改变已经编译的页面版本号。
# BUILD_VERSION=2026.09.28
NEXT_PUBLIC_EMBED_ORIGINS=https://voidream-web.pages.dev,https://voidream-community-staging.momentumofdreams.workers.dev,https://community-preview.voidream-web.pages.dev
CLOUDFLARED_PROTOCOL=auto
